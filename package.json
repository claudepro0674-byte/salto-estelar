{
  "name": "salto-estelar",
  "version": "1.0.0",
  "description": "Juego de plataformas 2D - Windows (Electron) y Android (Capacitor)",
  "private": true,
  "main": "electron/main.js",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "@capacitor/cli": "6.2.0"
  },
  "dependencies": {
    "@capacitor/core": "6.2.0",
    "@capacitor/android": "6.2.0"
  },
  "build": {
    "appId": "com.saltoestelar.app",
    "productName": "Salto Estelar",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
